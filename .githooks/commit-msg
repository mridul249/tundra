#!/bin/sh
#
# tundra commit linter.
#
# Enforces three rules:
#   1. Conventional-commit subject: type(scope)!: description
#   2. Subject only -- no commit body.
#   3. No personal e-mail addresses in the author/committer ident.
#
# Install:  git config core.hooksPath .githooks
# Manual:   .githooks/commit-msg <file-containing-a-commit-message>

set -eu

MSG_FILE="${1:?usage: commit-msg <message-file>}"

TYPES='feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert'
MAX_SUBJECT_LEN=72

PERSONAL_DOMAINS='gmail.com googlemail.com yahoo.com yahoo.co.in ymail.com
hotmail.com outlook.com live.com msn.com icloud.com me.com mac.com
aol.com gmx.com gmx.net mail.com zoho.com yandex.com yandex.ru
protonmail.com proton.me pm.me tutanota.com fastmail.com rediffmail.com'

TRAILERS='Signed-off-by Co-authored-by Reviewed-by Acked-by Tested-by
Reported-by Suggested-by Helped-by Cc Fixes Refs Closes Resolves'

fail() {
	printf '%s\n' "commit-msg: $*" >&2
	FAILED=1
}

FAILED=0

CLEAN=$(sed -e '/^# *-\{1,\} >8 -\{1,\}/,$d' -e '/^#/d' "$MSG_FILE")

SUBJECT=$(printf '%s\n' "$CLEAN" | sed -e '/./,$!d' | head -n 1)
# Body = everything after the subject, minus blank lines.
BODY=$(printf '%s\n' "$CLEAN" | sed -e '/./,$!d' | tail -n +2 | sed -e '/^[[:space:]]*$/d')

if [ -z "$SUBJECT" ]; then
	fail 'empty commit message.'
	printf '%s\n' "commit-msg: aborting." >&2
	exit 1
fi

# Merges, reverts and autosquash commits are generated by git; leave them be.
case "$SUBJECT" in
Merge\ * | Revert\ * | fixup!\ * | squash!\ * | amend!\ *)
	exit 0
	;;
esac

# Everything after the subject must be a git trailer ("Token: value"); anything
# else is prose and is rejected.
trailers=$(git config --get commitlint.trailers || printf '%s' "$TRAILERS")
trailer_re="^($(printf '%s' "$trailers" | tr -s '[:space:]' '|' | sed -e 's/^|//' -e 's/|$//')): .+$"

if [ -n "$BODY" ]; then
	prose=$(printf '%s\n' "$BODY" | grep -Ev "$trailer_re" || true)
	if [ -n "$prose" ]; then
		fail 'commit body is not allowed -- keep the message to a single subject line.'
		fail "  offending line: $(printf '%s\n' "$prose" | head -n 1)"
		fail "  allowed trailers: $(printf '%s' "$trailers" | tr -s '[:space:]' ' ')"
	fi
fi

if ! printf '%s' "$SUBJECT" |
	grep -Eq "^($TYPES)(\([a-z0-9][a-z0-9._/-]*\))?!?: [^[:space:]].*$"; then
	fail "subject does not match the convention: $SUBJECT"
	fail "  expected: <type>[(scope)][!]: <description>"
	fail "  types:    $(printf '%s' "$TYPES" | tr '|' ' ')"
fi

if [ "${#SUBJECT}" -gt "$MAX_SUBJECT_LEN" ]; then
	fail "subject is ${#SUBJECT} characters, limit is $MAX_SUBJECT_LEN."
fi

DESCRIPTION=${SUBJECT#*: }
case "$DESCRIPTION" in
*.)
	fail 'subject must not end with a period.'
	;;
esac
case "$DESCRIPTION" in
[A-Z]*)
	fail "description must start lower-case: $DESCRIPTION"
	;;
esac
if [ "${#DESCRIPTION}" -lt 10 ]; then
	fail "description is too short (min 10 characters): $DESCRIPTION"
fi

# no personal mail
domains=$(git config --get commitlint.personalDomains || printf '%s' "$PERSONAL_DOMAINS")

check_mail() {
	role=$1
	mail=$2
	[ -n "$mail" ] || return 0
	lower=$(printf '%s' "$mail" | tr '[:upper:]' '[:lower:]')
	host=${lower#*@}
	for d in $domains; do
		if [ "$host" = "$d" ]; then
			fail "$role e-mail <$mail> is a personal address."
			fail "  set a work address: git config user.email you@your-org.tld"
			return 0
		fi
	done
}

check_mail author "$(git var GIT_AUTHOR_IDENT | sed -n 's/.*<\(.*\)>.*/\1/p')"
check_mail committer "$(git var GIT_COMMITTER_IDENT | sed -n 's/.*<\(.*\)>.*/\1/p')"

# verdict
if [ "$FAILED" -ne 0 ]; then
	cat >&2 <<-EOF

		commit rejected. examples of accepted subjects:

		  feat(tun): allocate the device via TUNSETIFF
		  fix: drop packets shorter than the ip header
		  chore(deps): bump golang.org/x/sys to v0.47.0
		  refactor(net)!: return a reader instead of a raw fd

		to bypass in an emergency: git commit --no-verify
	EOF
	exit 1
fi

exit 0
